# Runtime settings. Nuxt maps NUXT_-prefixed variables onto runtimeConfig.
# Where the SQLite file lives (Coolify: persistent volume mounted at /data)
NUXT_DATABASE_PATH=/data/booking.db

# Key for the owner view at /admin?key=... — generate a long random string
NUXT_ADMIN_KEY=

# Public site URL (used for canonical/OG tags)
NUXT_PUBLIC_SITE_URL=https://demo.deplai.app

# "true" shows the demo banner and wipes data nightly; set to "false" for real use
NUXT_PUBLIC_DEMO_MODE=true
NUXT_RESET_ENABLED=true
